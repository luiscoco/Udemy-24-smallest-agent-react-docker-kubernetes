{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "smallest-agent",
    "namespace": "smallest-agent-24",
    "labels": {
      "app.kubernetes.io/name": "smallest-agent",
      "app.kubernetes.io/instance": "edition-24"
    }
  },
  "spec": {
    "replicas": 2,
    "revisionHistoryLimit": 3,
    "minReadySeconds": 5,
    "progressDeadlineSeconds": 180,
    "strategy": {
      "type": "RollingUpdate",
      "rollingUpdate": {
        "maxUnavailable": 0,
        "maxSurge": 1
      }
    },
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "smallest-agent",
        "app.kubernetes.io/instance": "edition-24"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "smallest-agent",
          "app.kubernetes.io/instance": "edition-24"
        }
      },
      "spec": {
        "serviceAccountName": "smallest-agent",
        "automountServiceAccountToken": false,
        "terminationGracePeriodSeconds": 120,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "runAsGroup": 1000,
          "fsGroup": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "app",
            "image": "smallest-agent:24",
            "imagePullPolicy": "IfNotPresent",
            "ports": [
              {
                "name": "http",
                "containerPort": 9900
              }
            ],
            "envFrom": [
              {
                "configMapRef": {
                  "name": "agent-config"
                }
              }
            ],
            "env": [
              {
                "name": "ANTHROPIC_API_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "name": "claude-api",
                    "key": "ANTHROPIC_API_KEY"
                  }
                }
              }
            ],
            "resources": {
              "requests": {
                "cpu": "250m",
                "memory": "512Mi"
              },
              "limits": {
                "cpu": "2",
                "memory": "2Gi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "startupProbe": {
              "httpGet": {
                "path": "/livez",
                "port": "http"
              },
              "periodSeconds": 2,
              "failureThreshold": 30
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/livez",
                "port": "http"
              },
              "periodSeconds": 15,
              "timeoutSeconds": 3
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/readyz",
                "port": "http"
              },
              "periodSeconds": 5,
              "timeoutSeconds": 3
            },
            "volumeMounts": [
              {
                "name": "temporary",
                "mountPath": "/tmp"
              }
            ]
          }
        ],
        "volumes": [
          {
            "name": "temporary",
            "emptyDir": {
              "sizeLimit": "512Mi"
            }
          }
        ]
      }
    }
  }
}
